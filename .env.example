# Used by docker-compose.yml (variable substitution) and, if copied to
# backend/.env, by the backend when run locally without Docker.

# --- Database ---
DATABASE_URL=sqlite:///./data/evosearch.db

# --- Storage ---
STORAGE_PATH=./data/uploads
VECTOR_INDEX_PATH=./data/vector_index

# --- Embeddings (local, no API key required) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM (Groq - Free) ---
# Get your API key from: https://console.groq.com/keys
# Leave blank to use the deterministic fallback.
GROQ_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Security ---
# Change this to a long random value in backend/.env
SECRET_KEY=change-this-in-production